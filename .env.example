# Lumper Backstop — all optional. With a key the tool runs live; without it,
# the same code path runs a labeled fallback (sandbox/cached/template) so the
# demo never breaks. Every tool call surfaces its backend in the trace.

# Gemini (routing, extraction, plain-English verdicts). google-genai SDK.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Google Maps Platform (Geocoding + Routes API v2)
GOOGLE_MAPS_API_KEY=

# EIA open data — free, instant: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# FMCSA QCMobile WebKey — free via Login.gov: https://mobile.fmcsa.dot.gov/qc
FMCSA_WEBKEY=

# Mongo (Memory Bank). Falls back to a JSON snapshot if unreachable.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=lumper_backstop

# Load board adapter: sandbox | dat | truckstop (only sandbox ships live)
LOADBOARD_ADAPTER=sandbox

# --- Email: Resend. REAL SENDS ARE OFF BY DEFAULT. ---
# The Outbox simulator is the default and is what the demo runs on. A key here
# is NOT permission to send: a real delivery needs all three of a key,
# MAIL_LIVE=true, and the recipient's domain listed in MAIL_LIVE_ALLOWLIST.
# Anything else is written to the Outbox and the trace says which lock stopped
# it. Reserved sandbox domains (example.com/.net/.org, .test, .invalid,
# .localhost) are refused outright even if allowlisted — every seeded broker
# lives on one, so no demo run can put mail on the wire.
# Leave MAIL_LIVE=false unless you are deliberately mailing a real inbox you
# own: these agents draft and send on their own initiative.
RESEND_API_KEY=
RESEND_FROM="Lumper Backstop <backstop@yourdomain.com>"
RESEND_REPLY_TO=
MAIL_LIVE=false
# Mail for a seeded broker is redirected here, labelled with who it was for.
DEMO_BROKER_EMAIL=
MAIL_LIVE_ALLOWLIST=
